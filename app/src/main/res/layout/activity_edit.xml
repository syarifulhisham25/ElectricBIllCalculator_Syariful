<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/editLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewEditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Electricity Bill"
            android:textColor="#0C2252"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textViewEditInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update the bill information below. The total charges and final cost will be recalculated automatically."
            android:textColor="#545454"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Month"
            android:textColor="#0C2252"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerEditMonth"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Electricity Unit Used (kWh)"
            android:textColor="#0C2252"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editTextEditUnit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Enter unit from 1 to 1000"
            android:inputType="number"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notice: Unit must be between 1 and 1000 kWh."
            android:textColor="#777777"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rebate Percentage"
            android:textColor="#0C2252"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinnerEditRebate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notice: Rebate must be between 0% and 5%."
            android:textColor="#777777"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/editResultBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Updated Calculation Result"
                android:textColor="#0C2252"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textViewEditTotalCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Charges: RM 0.00"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewEditFinalCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final Cost After Rebate: RM 0.00"
                android:textColor="#F9A826"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonUpdate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Update Record"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#0C2252"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#777777" />

    </LinearLayout>

</ScrollView>