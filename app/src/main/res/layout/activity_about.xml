<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/aboutLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textViewAboutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About MyElectric Bill"
            android:textColor="#0C2252"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/imageViewStudent"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/syariful"
            android:scaleType="centerCrop"
            android:contentDescription="Student Picture"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/studentInfoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Information"
                android:textColor="#0C2252"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textViewFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name: Muhammad Syariful Hisham bin Shieky"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewStudentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student ID: 2022258258"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewStudentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group: NBCS2408A"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewCourse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Course: ICT602 - Mobile Technology and Development"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewCopyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Copyright © 2026 Syariful. All rights reserved."
                android:textColor="#333333"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/appInfoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Application Description"
                android:textColor="#0C2252"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textViewAppDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MyElectric Bill is a mobile application that helps users estimate monthly electricity bills based on electricity usage and rebate percentage."
                android:textColor="#333333"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/textViewGithubUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GitHub URL"
                android:textColor="#1565C0"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/instructionBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How to Use the App"
                android:textColor="#0C2252"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textViewInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Select the month.\n2. Enter electricity unit used between 1 and 1000 kWh.\n3. Select rebate percentage between 0% and 5%.\n4. Tap Calculate Bill to view total charges and final cost.\n5. Tap Save Result to store the calculation.\n6. Tap View Saved Records to view, edit or delete saved bills."
                android:textColor="#333333"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonBackAbout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#777777"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>