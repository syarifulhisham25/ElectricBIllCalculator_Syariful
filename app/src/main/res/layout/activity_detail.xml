<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/detailLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bill Details"
            android:textColor="#0C2252"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textViewDetailInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View saved electricity bill details below. You may edit or delete this record."
            android:textColor="#545454"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/textViewMonthLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Month"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#0C2252"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/textViewUnitLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Electricity Unit Used"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#333333"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/textViewTotalChargesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Charges"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewTotalCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#333333"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/textViewRebateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rebate Percentage"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewRebate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#333333"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/textViewFinalCostLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final Cost After Rebate"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewFinalCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#F9A826"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonEdit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Edit Record"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#0C2252"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Delete Record"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#777777" />

    </LinearLayout>

</ScrollView>